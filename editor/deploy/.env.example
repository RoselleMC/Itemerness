# Copy to .env next to compose.yaml. Never commit a filled-in copy.
PORT=8080
# Loopback by default; the control plane is unauthenticated. Change only behind an authenticating proxy.
BIND_ADDRESS=127.0.0.1
PUBLIC_BASE_URL=https://items.example.com
POSTGRES_PASSWORD=replace-with-a-generated-secret
# openssl rand -hex 32. Changing it revokes every issued agent token; back it up with the database.
ITEMERNESS_TOKEN_PEPPER=replace-with-a-generated-secret
# Set to false in air-gapped installs; editors then mount a client jar in the browser instead.
ITEMERNESS_ALLOW_ASSET_FETCH=true
# Linux host paths. These mounts make the live catalog editable and mount the current BetterHud
# pack automatically whenever an editor page opens.
ITEMERNESS_CATALOG_HOST_PATH=/home/roselle/runo-server/server/plugins/Itemerness
RUNORPG_ATTRIBUTES_HOST_FILE=/home/roselle/runo-server/server/plugins/SimpleScript/scripts/runo/attributes/p0_attributes.kts
ITEMERNESS_RESOURCE_PACK_HOST_FILE=/home/roselle/runo-server/server/plugins/BetterHud/build.zip
LOG_LEVEL=info
