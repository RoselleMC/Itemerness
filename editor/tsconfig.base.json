{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": false,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@itemerness/protocol": ["packages/protocol/src/index.ts"],
            "@itemerness/protocol/*": ["packages/protocol/src/*"],
            "@itemerness/mc-assets": ["packages/mc-assets/src/index.ts"],
            "@itemerness/mc-assets/*": ["packages/mc-assets/src/*"],
            "@itemerness/mc-render": ["packages/mc-render/src/index.ts"],
            "@itemerness/mc-render/canvas": [
                "packages/mc-render/src/canvas.ts"
            ],
            "@itemerness/mc-render/*": ["packages/mc-render/src/*"],
            "@itemerness/ui": ["packages/ui/src/index.ts"],
            "@itemerness/ui/*": ["packages/ui/src/*"]
        }
    },
    "exclude": ["**/node_modules", "**/dist", "**/build"]
}
